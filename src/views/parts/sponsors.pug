//- Sponsors — one row per tier, never mixed
//- Data comes from src/data/sponsors.js, injected as `sponsors` (see bin/data.js).
//- The badge box and its background crop are computed per logo there, because
//- each logo file carries a different amount of padding.
section.sponsors-section
  .container
    .section-header
      h2 #{lang.lang.sponsorsTitle}
    .sponsors-grid
      each tier in sponsors
        .sponsor-tier(class=`sponsor-tier-${tier.tier}`)
          each sponsor in tier.sponsors
            a.sponsor-badge-link(
              href=sponsor.url,
              target='_blank',
              rel='nofollow sponsored noreferrer',
              title=sponsor.name,
              style=`--badge-w: ${sponsor.width}px; --badge-h: ${sponsor.height}px; --badge-size: ${sponsor.bgSizeW}% ${sponsor.bgSizeH}%; --badge-pos: ${sponsor.bgPosX}% ${sponsor.bgPosY}%; background-image: url('${sponsor.logo.src}')`
            )
    .become-sponsor
      p #{lang.lang.sponsorsInterested}
      a.sponsor-contact-link(href='mailto:zxdong@gmail.com?subject=Sponsorship%20Inquiry') #{lang.lang.sponsorsContact}
