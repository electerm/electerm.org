section.community
  .container
    h2 #{lang.lang.communityTitle}
    .community-qr-group
      .community-qr-item
        img.community-qr(src='https://electerm.org/electerm-wechat-group-qr.jpg' alt='WeChat Group QR Code')
        p #{lang.lang.communityWechatDesc}
      .community-qr-item
        img.community-qr(src='https://cdn.jsdelivr.net/gh/electerm/electerm-resource@master/static/images/telegram-qr.png' alt='Telegram Group QR Code' loading='lazy')
        p #{lang.lang.communityTelegramDesc}
