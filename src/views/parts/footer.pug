  .watermark

// 3D electerm logo: lazily swap the hero PNG for an animated, mouse-reactive WebGL model.
script(type='importmap').
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.169.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.169.0/examples/jsm/"
    }
  }
script(type='module').
  window.addEventListener('DOMContentLoaded', function () {
    var logo = document.querySelector('.hero-logo')
    if (!logo) return
    import('#{host}/js/hero-3d-logo.js')
      .then(function (mod) { new mod.default(logo, { modelUrl: '#{host}/electerm.glb' }) })
      .catch(function (err) { console.warn('[hero-3d-logo] init failed, keeping PNG logo', err) })
  })
