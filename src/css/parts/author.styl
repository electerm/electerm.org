/* ===== Home Author Section ===== */

.home-author
  padding 60px 0
  background var(--color-bg)

.author-inner
  max-width 700px
  margin 0 auto
  text-align center

.author-text h2
  font-size 1.2rem
  font-weight 700
  margin-bottom 10px

.author-text p
  font-size .88rem
  color var(--color-text-secondary)
  line-height 1.6
  margin-bottom 8px

.author-bio
  font-size .82rem
  color var(--color-text-secondary)
  opacity .85
  margin-bottom 14px

.author-links
  display flex
  flex-wrap wrap
  justify-content center
  gap 10px
  font-size .85rem
  margin-top 16px

.author-link
  color var(--color-primary)
  transition color .15s

.author-link:hover
  color var(--color-primary-dark)
