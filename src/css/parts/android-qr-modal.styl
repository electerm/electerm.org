/* ===== Android QR Modal (desktop mode) ===== */

.android-qr-modal
  display none
  position fixed
  top 0
  left 0
  width 100%
  height 100%
  z-index 9999
  align-items center
  justify-content center

.android-qr-modal.active
  display flex

.android-qr-overlay
  position absolute
  top 0
  left 0
  width 100%
  height 100%
  background rgba(0, 0, 0, 0.5)
  backdrop-filter blur(2px)

.android-qr-dialog
  position relative
  background var(--color-bg)
  border-radius var(--radius-lg)
  box-shadow var(--shadow-lg)
  padding 28px 32px 32px
  max-width 360px
  width calc(100% - 32px)
  text-align center
  z-index 1
  animation androidQrPop 0.2s ease-out

@keyframes androidQrPop
  from
    opacity 0
    transform scale(0.95) translateY(-8px)
  to
    opacity 1
    transform scale(1) translateY(0)

.android-qr-close
  position absolute
  top 12px
  right 16px
  background none
  border none
  font-size 1.6rem
  line-height 1
  cursor pointer
  color var(--color-text-secondary)
  padding 4px 8px
  border-radius var(--radius-sm)
  transition all 0.15s

.android-qr-close:hover
  color var(--color-text)
  background var(--color-bg-alt)

.android-qr-title
  font-size 1.15rem
  font-weight 600
  margin-bottom 8px

.android-qr-desc
  font-size 0.85rem
  color var(--color-text-secondary)
  margin-bottom 20px
  line-height 1.5

.android-qr-desc span
  font-weight 600
  color var(--color-text)

.android-qr-code
  display flex
  align-items center
  justify-content center
  min-height 180px
  margin-bottom 16px

.android-qr-code svg
  width 180px
  height 180px
  border-radius var(--radius-sm)

.android-qr-loading
  color var(--color-text-secondary)
  font-size 0.85rem

.android-qr-error
  color #dc2626
  font-size 0.85rem

.android-qr-url
  font-size 0.75rem
  color var(--color-text-secondary)
  word-break break-all
  margin-bottom 16px
  padding 8px 12px
  background var(--color-bg-alt)
  border-radius var(--radius-sm)
  font-family 'SF Mono', 'Fira Code', monospace
  line-height 1.4
  max-height 60px
  overflow-y auto

.android-qr-download
  display inline-block
  padding 10px 24px
  background var(--color-primary)
  color white
  border-radius var(--radius-md)
  font-size 0.9rem
  font-weight 500
  text-decoration none
  transition all 0.2s

.android-qr-download:hover
  background var(--color-primary-dark)
  color #fff

@media (max-width: 479px)
  .android-qr-dialog
    padding 24px 20px 24px
  .android-qr-code svg
    width 150px
    height 150px
