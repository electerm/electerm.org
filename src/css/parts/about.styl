/* ===== About Page ===== */

.about-page
  padding 80px 0 100px
  background var(--color-bg)

.about-content
  max-width 800px
  margin 0 auto

.about-content h1
  font-size 2rem
  font-weight 700
  margin-bottom 8px

.about-content .about-lead
  font-size 1.1rem
  color var(--color-text)
  margin-bottom 16px
  line-height 1.75

.about-content .about-supports
  padding 12px 16px
  margin-bottom 18px
  background var(--color-border-light)
  border-left 3px solid var(--color-primary)
  border-radius var(--radius-sm, 6px)
  color var(--color-text-secondary)
  font-size .95rem
  line-height 1.75

.about-content p
  margin-bottom 14px
  line-height 1.75
  color var(--color-text-secondary)
  font-size .95rem

.about-content h2
  font-size 1.3rem
  font-weight 600
  margin-top 40px
  margin-bottom 16px
  padding-bottom 8px
  border-bottom 2px solid var(--color-primary)
  display inline-block

.about-content h3
  font-size 1.05rem
  font-weight 600
  margin-top 24px
  margin-bottom 10px

.about-content ul
  margin-bottom 14px
  padding-left 24px

.about-content li
  margin-bottom 8px
  line-height 1.7
  color var(--color-text-secondary)
  font-size .95rem

.about-content li strong
  color var(--color-text)

.about-content a
  color var(--color-primary)

.about-content a:hover
  color var(--color-primary-dark)

.about-content code
  background var(--color-bg-alt)
  padding 2px 6px
  border-radius 4px
  font-size .85rem
  font-family var(--font-mono)
  border 1px solid var(--color-border-light)

.about-content pre
  background var(--color-bg-alt)
  border 1px solid var(--color-border)
  border-radius var(--radius-md)
  padding 20px 24px
  margin-bottom 20px
  overflow-x auto
  font-size .85rem
  line-height 1.6

.about-content pre code
  background none
  padding 0
  border none
  border-radius 0
  font-size inherit

.about-links-grid
  display grid
  grid-template-columns 1fr
  gap 16px
  margin-bottom 24px

@media (min-width: 600px)
  .about-links-grid
    grid-template-columns repeat(2, 1fr)

.about-link-card
  padding 24px
  border 1px solid var(--color-border)
  border-radius var(--radius-lg)
  transition all .2s

.about-link-card:hover
  border-color var(--color-primary)
  box-shadow var(--shadow-md)

.about-link-card h3
  font-size 1rem
  font-weight 600
  margin-bottom 8px
  margin-top 0

.about-link-card p
  font-size .85rem
  color var(--color-text-secondary)
  margin-bottom 12px

.about-content .about-link
  display inline-flex
  align-items center
  gap 4px
  padding 8px 16px
  background var(--color-primary)
  color white
  border-radius var(--radius-sm)
  font-size .85rem
  font-weight 500
  transition all .2s

.about-content .about-link:hover
  background var(--color-primary-dark)
  color white
