/* ===== Contact Page ===== */

.contact-grid
  display grid
  grid-template-columns 1fr
  gap 20px
  margin 32px 0

@media (min-width: 600px)
  .contact-grid
    grid-template-columns repeat(3, 1fr)

.contact-card
  padding 28px 24px
  border 1px solid var(--color-border)
  border-radius var(--radius-lg)
  text-align center
  transition all .25s

.contact-card:hover
  border-color var(--color-primary)
  box-shadow var(--shadow-md)
  transform translateY(-2px)

.contact-icon
  font-size 2rem
  margin-bottom 12px

.contact-card h3
  font-size 1rem
  font-weight 600
  margin-bottom 8px

.contact-card p
  font-size .85rem
  color var(--color-text-secondary)
  margin-bottom 16px
  line-height 1.5

.privacy-content .contact-link
  display inline-flex
  align-items center
  gap 4px
  padding 8px 20px
  background var(--color-primary)
  color white
  border-radius var(--radius-sm)
  font-size .85rem
  font-weight 500
  transition all .2s

.privacy-content .contact-link:hover
  background var(--color-primary-dark)
  color white

.contact-wechat-section
  text-align center
  margin-top 40px
  padding-top 32px
  border-top 1px solid var(--color-border)

.contact-wechat-section h2
  font-size 1.2rem
  font-weight 700
  margin-bottom 8px
  border none
  display block
  margin-top 0

.contact-wechat-section p
  color var(--color-text-secondary)
  font-size .9rem
  margin-bottom 16px

.contact-qr
  max-width 200px
  border-radius var(--radius-md)
  box-shadow var(--shadow-md)
