/* ===== Demo ===== */

.demo-section
  padding 80px 0
  background var(--color-bg-alt)

/* Standalone controls bar above the browser frame */
.demo-controls
  max-width 960px
  margin 0 auto 16px
  display flex
  align-items center
  justify-content center
  gap 16px

.demo-switch
  display flex
  background var(--color-bg)
  border 1px solid var(--color-border)
  border-radius var(--radius-sm)
  overflow hidden

.demo-switch-btn
  padding 7px 16px
  font-size 0.82rem
  color var(--color-text-secondary)
  background transparent
  border none
  cursor pointer
  transition all 0.15s
  white-space nowrap
  font-family inherit

.demo-switch-btn:hover
  color var(--color-text)

.demo-switch-btn.active
  color white
  background var(--color-primary)

.demo-fullscreen
  padding 7px 14px
  border-radius var(--radius-sm)
  font-size 0.82rem
  color var(--color-text-secondary)
  border 1px solid var(--color-border)
  white-space nowrap
  transition all 0.15s

.demo-fullscreen:hover
  color var(--color-text)
  border-color var(--color-primary)

.demo-wrapper
  max-width 960px
  margin 0 auto
  border-radius var(--radius-lg)
  overflow hidden
  box-shadow var(--shadow-xl)
  border 1px solid var(--color-border)
  transition max-width 0.25s ease

.demo-toolbar
  display flex
  align-items center
  gap 12px
  padding 12px 16px
  background #2d2d2d
  border-bottom 1px solid rgba(255,255,255,0.08)

.demo-dots
  display flex
  gap 7px

.demo-dots span
  width 12px
  height 12px
  border-radius 50%

.dot-red
  background #ff5f57

.dot-yellow
  background #febc2e

.dot-green
  background #28c840

.demo-address
  flex 1
  display flex
  align-items center
  gap 8px
  padding 6px 14px
  background rgba(255,255,255,0.08)
  border-radius 6px
  font-size 0.82rem
  color rgba(255,255,255,0.6)
  font-family var(--font-mono)

.demo-iframe
  display block
  width 100%
  height 500px
  border none
  background #1e1e1e
  transition height 0.25s ease

/* Mobile mode: 9:16 aspect ratio, centered phone frame */
.demo-wrapper.mobile
  max-width 380px

.demo-wrapper.mobile .demo-iframe
  height calc(380px * 16 / 9)

@media (min-width: 768px)
  .demo-iframe
    height 600px

@media (max-width: 767px)
  .demo-controls
    margin-bottom 12px
    gap 10px
  .demo-switch-btn
    padding 5px 10px
    font-size 0.75rem
  .demo-fullscreen
    padding 5px 10px
    font-size 0.75rem
  .demo-toolbar
    padding 10px 12px
  .demo-address
    font-size 0.75rem
    padding 4px 10px
  .demo-iframe
    height 400px
