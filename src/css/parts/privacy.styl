/* ===== Privacy Policy ===== */

.privacy-page
  padding 80px 0 100px
  background var(--color-bg)

.privacy-content
  max-width 800px
  margin 0 auto

.privacy-content h1
  font-size 2rem
  font-weight 700
  margin-bottom 8px

.privacy-content .last-updated
  color var(--color-text-secondary)
  font-size .9rem
  margin-bottom 40px

.privacy-content h2
  font-size 1.3rem
  font-weight 600
  margin-top 36px
  margin-bottom 16px
  padding-bottom 8px
  border-bottom 2px solid var(--color-primary)
  display inline-block

.privacy-content h3
  font-size 1.05rem
  font-weight 600
  margin-top 24px
  margin-bottom 10px

.privacy-content p
  margin-bottom 14px
  line-height 1.75
  color var(--color-text-secondary)
  font-size .95rem

.privacy-content ul
  margin-bottom 14px
  padding-left 24px

.privacy-content li
  margin-bottom 8px
  line-height 1.7
  color var(--color-text-secondary)
  font-size .95rem

.privacy-content a
  color var(--color-primary)

.privacy-content a:hover
  color var(--color-primary-dark)

.privacy-content table
  width 100%
  border-collapse collapse
  margin 16px 0 24px
  font-size .9rem

.privacy-content th,
.privacy-content td
  padding 12px 16px
  text-align left
  border 1px solid var(--color-border)

.privacy-content th
  background var(--color-bg-alt)
  font-weight 600
  color var(--color-text)

.privacy-content td
  color var(--color-text-secondary)
