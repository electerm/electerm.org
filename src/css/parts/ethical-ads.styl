/* ===== EthicalAds ===== */

.ethical-ad-wrapper
  // Hidden by default; shown by JS (ethical-ad-active) only when loading EthicalAds
  display none
  position fixed
  bottom 0
  left 0
  right 0
  z-index 998
  min-height 56px
  align-items center
  justify-content center
  padding 8px 20px
  background var(--color-bg-alt)
  border-top 1px solid var(--color-border)

  // When JS activates it, restore intended layout
  &.ethical-ad-active
    display flex

  // >= 1420px: corner card
  @media (min-width: 1420px)
    min-height auto
    bottom 24px
    left auto
    right 24px
    z-index 999
    padding 0
    border none
    max-width 300px
    background white
    border-radius var(--radius-md)
    box-shadow var(--shadow-lg)

    &.ethical-ad-active
      display block

// Reserve space so the fixed ad bar/card doesn't cover footer content.
// Applies to whichever network is in use (EthicalAds or Carbon Ads wrapper
// present in the DOM). JS refines these to the actual rendered ad height.
@media (max-width: 1419px)
  body:has(.ethical-ad-wrapper, .carbon-ad-wrapper)
    padding-bottom 56px
@media (min-width: 1420px)
  body:has(.ethical-ad-wrapper, .carbon-ad-wrapper) .site-footer
    padding-bottom 80px

// Ad unit visibility — always visible; JS controls type/layout
.ethical-ad-unit
  display block
