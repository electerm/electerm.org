/* ===== Hero OS-variant highlight animation (.hero-supports) ===== */

/* Idle tokens are plain text; only .os-active gets pill + emoji + link */
.hero-supports
  .os-chip
    padding 0
    margin 0
    border 0
    border-radius 0
    background transparent
    color inherit
    font-weight inherit
    font-size inherit
    line-height inherit
    white-space nowrap
    cursor inherit
    transition background 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease
  .os-chip .os-emoji
    margin-right 4px
    font-size 0.95em
  .os-chip.os-active
    display inline-block
    padding 1px 9px 2px
    margin 1px 1px
    border 1px solid var(--color-primary)
    border-radius 999px
    background var(--color-primary)
    color #fff
    font-weight 600
    font-size 0.92em
    line-height 1.6
    cursor pointer
    box-shadow 0 3px 14px rgba(37, 99, 235, 0.45)
    transform translateY(-1px) scale(1.05)
    &:hover
      color #fff
      transform translateY(-1px)
  .os-chip.os-pop
    animation osPop 0.45s ease
  &.os-static .os-chip
    background transparent

@keyframes osPop
  0%
    transform scale(1)
  40%
    transform translateY(-2px) scale(1.12) rotate(-1.2deg)
  100%
    transform translateY(-1px) scale(1.05)

@media (prefers-reduced-motion: reduce)
  .hero-supports .os-chip.os-pop
    animation none
