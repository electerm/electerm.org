/* ===== Home FAQ Section ===== */

.home-faq
  padding 60px 0
  background var(--color-bg-alt)

.home-faq-list
  max-width 700px
  margin 0 auto
  display flex
  flex-direction column
  gap 16px

.home-faq-item
  background var(--color-bg)
  border 1px solid var(--color-border)
  border-radius var(--radius-md)
  padding 20px 24px
  transition all .2s

.home-faq-item:hover
  border-color var(--color-primary)
  box-shadow var(--shadow-sm)

.home-faq-q
  font-weight 600
  font-size .95rem
  margin-bottom 6px
  color var(--color-text)

.home-faq-a
  font-size .88rem
  color var(--color-text-secondary)
  line-height 1.6

.home-faq-more
  text-align center
  margin-top 28px

.home-faq-link
  display inline-flex
  align-items center
  gap 6px
  padding 10px 24px
  background var(--color-primary)
  color white
  border-radius var(--radius-md)
  font-size .9rem
  font-weight 500
  transition all .2s

.home-faq-link:hover
  background var(--color-primary-dark)
  color white
