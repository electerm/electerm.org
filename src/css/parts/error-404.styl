/* ===== 404 Error Page ===== */

.error-page
  padding 80px 0
  min-height 60vh
  display flex
  align-items center

.error-content
  text-align center
  max-width 600px
  margin 0 auto

.error-code
  font-size 6rem
  font-weight 800
  color var(--color-primary)
  margin 0
  line-height 1

.error-title
  font-size 1.8rem
  font-weight 700
  margin 16px 0 12px

.error-desc
  color var(--color-text-secondary)
  font-size 1rem
  line-height 1.6
  margin-bottom 32px

.error-actions
  display flex
  flex-wrap wrap
  justify-content center
  gap 12px
  margin-bottom 32px

.error-btn
  display inline-flex
  align-items center
  padding 10px 20px
  border-radius var(--radius-sm)
  font-size .9rem
  font-weight 500
  text-decoration none
  transition all .15s

.error-btn-primary
  background var(--color-primary)
  color white

.error-btn-primary:hover
  background var(--color-primary-dark)
  color white

.error-btn-secondary
  background var(--color-bg-secondary)
  color var(--color-text)
  border 1px solid var(--color-border)

.error-btn-secondary:hover
  background var(--color-border)
  color var(--color-text)

.error-search
  margin-bottom 24px

.error-search-label
  color var(--color-text-secondary)
  font-size .85rem
  margin-bottom 8px

.error-search-link
  display inline-block
  margin 0 8px
  color var(--color-primary)
  font-size .85rem

.error-search-link:hover
  text-decoration underline

.error-report
  padding-top 20px
  border-top 1px solid var(--color-border)
  font-size .82rem
  color var(--color-text-secondary)

.error-report a
  color var(--color-primary)

.error-report a:hover
  text-decoration underline
.mg1r
 margin-right 5px
