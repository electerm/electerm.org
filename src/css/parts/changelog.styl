/* ===== Changelog ===== */

.changelog
  padding 60px 0
  background var(--color-bg)

.changelog-card
  background var(--color-bg-alt)
  border-radius var(--radius-lg)
  padding 32px
  max-width 800px
  margin 0 auto

.changelog-header
  display flex
  align-items center
  gap 16px
  margin-bottom 20px
  flex-wrap wrap

.changelog-version-badge
  padding 4px 12px
  background var(--color-primary)
  color white
  border-radius 100px
  font-size 0.85rem
  font-weight 600

.changelog-date
  color var(--color-text-secondary)
  font-size 0.9rem

.changelog-body
  line-height 1.8
  font-size 0.92rem

.changelog-body p
  padding 4px 0

.changelog-body .separator
  border-top 1px solid var(--color-border)
  margin 12px 0
