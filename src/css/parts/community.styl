/* ===== Community ===== */

.community
  padding 60px 0
  background var(--color-bg-alt)
  text-align center

.community h2
  font-size 1.5rem
  margin-bottom 20px

.community-qr-group
  display flex
  flex-wrap wrap
  justify-content center
  align-items flex-start
  gap 40px

.community-qr-item
  flex 0 1 auto
  max-width 260px

.community-qr-item p
  margin 0

.community-qr
  display block
  height 300px
  width auto
  max-width 100%
  margin 0 auto 12px
  border-radius var(--radius-md)
  box-shadow var(--shadow-md)

.community p
  color var(--color-text-secondary)
  font-size 0.9rem
