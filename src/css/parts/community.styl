/* ===== Community ===== */

.community
  padding 60px 0
  background var(--color-bg-alt)
  text-align center

.community h2
  font-size 1.5rem
  margin-bottom 20px

.community-qr
  max-width 80%
  border-radius var(--radius-md)
  box-shadow var(--shadow-md)
  margin-bottom 12px

.community p
  color var(--color-text-secondary)
  font-size 0.9rem
